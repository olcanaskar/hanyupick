{
  "expo": {
    "name": "HanyuPick",
    "slug": "hanyupick",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "io.github.olcanaskar.hanyupick"
    },
    "android": {
      "package": "io.github.olcanaskar.hanyupick",
      "adaptiveIcon": {
        "backgroundColor": "#B91C1C",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "name": "HanyuPick — HSK 1-6 Vocabulary Quiz",
      "shortName": "HanyuPick",
      "lang": "en",
      "themeColor": "#FBF5EB",
      "backgroundColor": "#EFE7DA",
      "display": "standalone"
    },
    "extra": {
      "eas": {
        "projectId": "ea29583b-1b9a-43c1-8d61-6915c3745c27"
      }
    },
    "owner": "olcanaskar",
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FBF5EB",
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain"
        }
      ]
    ]
  }
}
