{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "checkJs": true,
    "strict": false,
    "noImplicitAny": false,
    "types": ["jest"]
  },
  "include": [
    "App.js",
    "index.js",
    "jest.setup.js",
    "services/**/*.js",
    "screens/**/*.js",
    "components/**/*.js",
    "__tests__/**/*.js"
  ]
}
